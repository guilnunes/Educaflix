{
  "name": "educaflix",
  "private": true,
  "version": "0.1.0",
  "description": "Educaflix (nome temporário): admin de geração de vídeos educativos com IA e aprovação humana.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/copy-content.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "setup:piper": "python3 -m venv .cache/piper-venv && .cache/piper-venv/bin/pip install -q piper-tts && .cache/piper-venv/bin/python -m piper.download_voices --download-dir .cache/piper pt_BR-faber-medium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^3.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
