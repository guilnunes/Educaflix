# Educaflix: configuração do modo local (npm run dev).
# Copie para .env (cp .env.example .env) e ajuste. O .env fica só na sua máquina
# e nunca vai para o repositório. Sem .env, tudo roda com os exemplos (mock).

# Porta do servidor local (API). O Vite (porta 5173) repassa /api e /content para ela.
API_PORT=8787

# ---------------------------------------------------------------------------
# Modelo padrão de cada tipo: <TIPO>_PROVIDER = provedor, <TIPO>_MODEL = modelo.
# No admin, o botão "Gerar de novo" deixa trocar o modelo de uma geração.
# Opções em docs/opcoes-de-modelos.md e server/providers/registry.ts.
#
# PERFIL ATIVO: gratuito + assinaturas (não precisa de cartão).
# ---------------------------------------------------------------------------

# Texto: Claude pela assinatura Pro/Max, via Claude Code instalado e logado
# ("claude" no terminal). Alternativa sem nada instalado: TEXT_PROVIDER=mock
TEXT_PROVIDER=claude-assinatura
TEXT_MODEL=sonnet

# Imagem: não há opção gratuita por API. Fica no exemplo (SVG) até ligar a
# cobrança do Gemini ou do fal (veja o perfil recomendado abaixo).
IMAGE_PROVIDER=mock
IMAGE_MODEL=mock-svg-v1

# Voz: Piper, local e gratuito (instale com: npm run setup:piper).
# Com assinatura da ElevenLabs: SPEECH_PROVIDER=elevenlabs e SPEECH_MODEL=eleven_v4
SPEECH_PROVIDER=piper
SPEECH_MODEL=pt_BR-faber-medium

# Música: jingle de exemplo. Com plano pago da ElevenLabs:
# MUSIC_PROVIDER=elevenlabs e MUSIC_MODEL=music_v2_5
MUSIC_PROVIDER=mock
MUSIC_MODEL=mock-jingle-v1

# Vídeo: montagem local com ffmpeg (instale o ffmpeg: brew install ffmpeg,
# sudo apt install ffmpeg ou winget install ffmpeg).
VIDEO_PROVIDER=ffmpeg
VIDEO_MODEL=montagem-local-v1

# ---------------------------------------------------------------------------
# PERFIL RECOMENDADO com cobrança por uso (menos de US$ 1 por vídeo).
# Descomente e troque pelos valores de cima quando tiver as chaves.
# ---------------------------------------------------------------------------
# TEXT_PROVIDER=anthropic
# TEXT_MODEL=claude-haiku-5-5          # comparar com claude-sonnet-5-5
# IMAGE_PROVIDER=google
# IMAGE_MODEL=gemini-3.1-flash-image   # comparar com fal:fal-ai/flux-2/klein/4b
# SPEECH_PROVIDER=elevenlabs
# SPEECH_MODEL=eleven_v4               # comparar com piper
# MUSIC_PROVIDER=google
# MUSIC_MODEL=lyria-3-clip-preview     # comparar com elevenlabs:music_v2_5
# VIDEO_PROVIDER=ffmpeg
# VIDEO_MODEL=montagem-local-v1        # comparar com fal-kling (anima 3 cenas)

# ---------------------------------------------------------------------------
# Chaves de API. Preencha só as que for usar.
# ---------------------------------------------------------------------------
# Claude pela API (console.anthropic.com). Não é usada pelo provedor por assinatura.
# ANTHROPIC_API_KEY=
# Gemini Flash Image e Lyria (aistudio.google.com). Imagem e música exigem cobrança ativa.
# GOOGLE_API_KEY=
# ElevenLabs (elevenlabs.io > Developers > API Keys). Usa os créditos da assinatura.
# ELEVENLABS_API_KEY=
# FLUX.2 Klein e Kling (fal.ai > Keys).
# FAL_KEY=

# ---------------------------------------------------------------------------
# Ajustes opcionais
# ---------------------------------------------------------------------------
# Voz da ElevenLabs (id da voz escolhida no site). Padrão: George.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Kling: modelo no fal e quantas cenas animar por vídeo.
# FAL_KLING_MODEL=fal-ai/kling-video/v3/standard/image-to-video
# KLING_SCENES=3
# Piper: programa, pasta das vozes e velocidade (maior = mais devagar).
# PIPER_BIN=.cache/piper-venv/bin/piper
# PIPER_DATA_DIR=.cache/piper
# PIPER_LENGTH_SCALE=1.1
# Caminhos de programas, se não estiverem no PATH.
# CLAUDE_CLI_PATH=claude
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
