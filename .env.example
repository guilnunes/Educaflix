# Educaflix: configuração do modo local (npm run dev).
# Copie este arquivo para .env (cp .env.example .env) e ajuste.
# O .env fica só na sua máquina e nunca vai para o repositório.

# Porta do servidor local (API). O Vite (porta 5173) repassa /api e /content para ela.
API_PORT=8787

# ---------------------------------------------------------------------------
# Provedor e modelo padrão de cada tipo.
# Formato: <TIPO>_PROVIDER = nome do provedor, <TIPO>_MODEL = modelo dentro dele.
# Hoje só existe o provedor "mock", que gera conteúdo de exemplo sem chave nenhuma.
# Provedores reais entram em server/providers/ (veja o README).
# ---------------------------------------------------------------------------

# Texto: assuntos, temas, roteiro, quiz e letra da música
TEXT_PROVIDER=mock
TEXT_MODEL=mock-texto-v1

# Imagem: uma imagem por cena do storyboard
IMAGE_PROVIDER=mock
IMAGE_MODEL=mock-svg-v1

# Voz: narração em português (o mock usa a voz do navegador na hora de tocar)
SPEECH_PROVIDER=mock
SPEECH_MODEL=mock-voz-navegador

# Música: trilha a partir da letra aprovada
MUSIC_PROVIDER=mock
MUSIC_MODEL=mock-jingle-v1

# Vídeo: monta o vídeo final a partir das cenas, narração e música
VIDEO_PROVIDER=mock
VIDEO_MODEL=mock-animatic-v1

# ---------------------------------------------------------------------------
# Chaves de API dos provedores reais.
# Ficam vazias até escolhermos os modelos. Preencha só no seu .env.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ELEVENLABS_API_KEY=
# REPLICATE_API_TOKEN=
